{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Website da Implement — Cloudflare Worker com ficheiros estáticos (public/) e API do formulário (src/worker.js)
  "name": "implement",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-31",
  "upload_source_maps": true,
  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Só a API, o blog e a área da equipa passam pelo Worker; as outras páginas são servidas diretamente
    "run_worker_first": ["/api/*", "/insights", "/insights/*", "/insights.html", "/work", "/work/*", "/work.html", "/media/*", "/admin", "/admin/*"]
  },

  // Base de dados dos pedidos do formulário «Start a Project».
  // A tabela «pedidos» é criada automaticamente pelo Worker no primeiro pedido (ver schema.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "implement-pedidos",
      "database_id": "a7da3f3e-ad90-4f94-9184-18bf6da8cdb9"
    }
  ],

  // Notificação por e-mail (Cloudflare Email Service, plano Workers Paid).
  // heyimplement.com está ativo no Email Sending; os avisos vão de site@heyimplement.com para info@heyimplement.com.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "EMAIL_DESTINO": "info@heyimplement.com",
    "EMAIL_REMETENTE": "site@heyimplement.com"
  }
}
