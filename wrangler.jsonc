{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Website da Implement — Cloudflare Worker com ficheiros estáticos (public/) e API do formulário (src/worker.js)
  "name": "implement",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-31",
  "upload_source_maps": true,
  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Só a API passa pelo Worker; as páginas são servidas diretamente (mais rápido e sem custo de pedidos)
    "run_worker_first": ["/api/*"]
  },

  // Base de dados dos pedidos do formulário «Start a Project».
  // A tabela «pedidos» é criada automaticamente pelo Worker no primeiro pedido (ver schema.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "implement-pedidos",
      "database_id": "a7da3f3e-ad90-4f94-9184-18bf6da8cdb9"
    }
  ],

  // Notificação por e-mail (Cloudflare Email Service).
  // Só funciona depois de heyimplement.com estar no Cloudflare e o domínio estar «onboarded» no Email Service.
  // Até lá, deixe comentado: os pedidos ficam guardados na base de dados na mesma.
  // "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "EMAIL_DESTINO": "info@heyimplement.com",
    "EMAIL_REMETENTE": "site@heyimplement.com"
  }
}
